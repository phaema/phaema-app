# Copy to .env and change for any server deployment. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DB_PASSWORD=change-me
DEBUG=False
SECURE_COOKIES=False
ALLOWED_HOSTS=localhost,127.0.0.1
# On a server behind an HTTPS proxy: set SECURE_COOKIES=True and BEHIND_HTTPS_PROXY=True,
# and set PHAEMA_BASE_URL to the https:// address (it is trusted for forms automatically).
BEHIND_HTTPS_PROXY=False
# Extra addresses allowed to submit forms, comma separated, e.g. https://phaema.example.gov.uk
CSRF_TRUSTED_ORIGINS=
PHAEMA_ORGANISATION_NAME=Demonstration Council
# Web address of this PHAEMA, used in email links
PHAEMA_BASE_URL=http://localhost:8000
# Email for reminders (leave EMAIL_HOST blank to write emails to the log instead)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=PHAEMA <phaema@example.gov.uk>
# Single sign-on (optional): Microsoft 365 (Entra ID), Keycloak or another OpenID Connect service.
# Leave blank to keep PHAEMA sign-in only. See docs/single-sign-on.md.
# For Microsoft 365: https://login.microsoftonline.com/<tenant ID>/v2.0
PHAEMA_SSO_ISSUER=
PHAEMA_SSO_CLIENT_ID=
PHAEMA_SSO_CLIENT_SECRET=
PHAEMA_SSO_NAME=Microsoft
