# Copy to .env and change for any server deployment. Never commit .env.
# PHAEMA refuses to start without a random SECRET_KEY of 32 characters or more (./phaema.sh start makes one).
SECRET_KEY=
DB_PASSWORD=change-me
DEBUG=False
SECURE_COOKIES=False
ALLOWED_HOSTS=localhost,127.0.0.1
# On a server behind an HTTPS proxy: set SECURE_COOKIES=True and BEHIND_HTTPS_PROXY=True,
# and set PHAEMA_BASE_URL to the https:// address (it is trusted for forms automatically).
BEHIND_HTTPS_PROXY=False
# Extra addresses allowed to submit forms, comma separated, e.g. https://phaema.example.gov.uk
CSRF_TRUSTED_ORIGINS=
PHAEMA_ORGANISATION_NAME=Demonstration Council
# Web address of this PHAEMA, used in email links
PHAEMA_BASE_URL=http://localhost:8000
# Email for reminders (leave EMAIL_HOST blank to write emails to the log instead)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=PHAEMA <phaema@example.gov.uk>
# Single sign-on (optional): Microsoft 365 (Entra ID), Keycloak or another OpenID Connect service.
# Leave blank to keep PHAEMA sign-in only. See docs/single-sign-on.md.
# For Microsoft 365: https://login.microsoftonline.com/<tenant ID>/v2.0
PHAEMA_SSO_ISSUER=
PHAEMA_SSO_CLIENT_ID=
PHAEMA_SSO_CLIENT_SECRET=
PHAEMA_SSO_NAME=Microsoft
# Reading text in scanned PDFs (OCR), done on this server by the scheduler. English by default; a Welsh council
# can use eng+cym. Documents over the page limit are not read.
PHAEMA_OCR_LANGUAGES=eng
PHAEMA_OCR_MAX_PAGES=500
# Sessions end after this many hours, or after this many minutes without using PHAEMA.
PHAEMA_SESSION_HOURS=10
PHAEMA_IDLE_MINUTES=120
# Wrong passwords allowed in 15 minutes before sign-in is paused: per account, and per connection.
PHAEMA_SIGNIN_MAX_PER_ACCOUNT=10
PHAEMA_SIGNIN_MAX_PER_ADDRESS=50
# Other systems use the API with API tokens (Manage data, API tokens). Set True only to let old scripts keep
# signing in to the API with a username and password (never for accounts with two-step sign-in).
PHAEMA_API_PASSWORD_SIGN_IN=False

# Content-Security-Policy (on by default). Report-only sends the policy without enforcing it, to check first.
# PHAEMA_CSP_ENABLED=True
# PHAEMA_CSP_REPORT_ONLY=False
# Extra map tile or API addresses, comma-separated, e.g. https://tiles.example.gov.uk
# PHAEMA_CSP_IMG_SOURCES=
# PHAEMA_CSP_CONNECT_SOURCES=
# HTTPS only (with DEBUG off): HSTS is sent for a year. Add subdomains once the council's domain is settled;
# set the redirect only if PHAEMA is reached without an HTTPS proxy in front.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_SSL_REDIRECT=False
