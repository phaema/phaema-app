# Caddy gets and renews a free Let's Encrypt certificate for the domain by itself.
{$PHAEMA_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 60MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
	reverse_proxy web:8000
}
